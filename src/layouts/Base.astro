---
import { SITE } from "@/site.config";
import BaseHead from "@/components/BaseHead.astro";
import Taskbar from "@/components/Taskbar.astro";
import StartMenu from "@/components/StartMenu.astro";
import "@/styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
}
const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div id="main" tabindex="-1">
      <slot />
    </div>

    <StartMenu />
    <Taskbar />

    <div id="screensaver" aria-hidden="true">
      <img src="/logo.svg" alt="" width="130" />
    </div>

    <script>
      import "@/scripts/desktop.ts";
    </script>
  </body>
</html>
