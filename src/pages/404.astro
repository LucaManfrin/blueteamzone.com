---
import Base from "@/layouts/Base.astro";
import Window from "@/components/Window.astro";
---

<Base
  title="404 — Page not found"
  description="The page you requested could not be found."
  noindex={true}
>
  <Window
    class="error-dialog"
    title="System Error"
    icon="/icons/about.svg"
    winId="error"
    closeAction="back"
    floating={false}
    taskbar={false}
  >
    <div class="error-dialog__body">
      <div class="error-dialog__icon" aria-hidden="true">✕</div>
      <div class="error-dialog__msg">
        <p style="margin:0 0 8px">
          <strong>This page has performed an illegal operation and cannot be found.</strong>
        </p>
        <p style="margin:0;color:var(--face-text-muted)">
          The shortcut you followed is broken, the note was archived, or it
          never existed. Error code: <code>0x00000194</code>.
        </p>
      </div>
    </div>
    <div class="error-dialog__btns">
      <a class="btn" href="/">Return to Desktop</a>
      <a class="btn" href="/find">Find a note…</a>
    </div>
  </Window>
</Base>
