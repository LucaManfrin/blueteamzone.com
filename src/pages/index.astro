---
import Base from "@/layouts/Base.astro";
import Window from "@/components/Window.astro";
import MenuBar from "@/components/MenuBar.astro";
import PostList from "@/components/PostList.astro";
import DesktopIcons from "@/components/DesktopIcons.astro";
import { SITE, HOME_LATEST_COUNT, HOME_PINNED_COUNT } from "@/site.config";
import { getLatest, getPinned } from "@/lib/posts";

const latest = await getLatest(HOME_LATEST_COUNT);
const pinned = await getPinned(HOME_PINNED_COUNT);
const hasNone = latest.length === 0;
---

<Base title={SITE.title} description={SITE.description}>
  <div class="desktop">
    <DesktopIcons />

    <Window
      title="Latest Notes — My Notebook"
      icon="/icons/latest.svg"
      winId="latest"
      floating={true}
      closeAction="hide"
      style="left:24px; top:128px; width:min(780px,94vw);"
    >
      <MenuBar slot="menubar" variant="explorer" />

      <p style="margin:0 0 10px; font-size:12px; color:var(--face-text-muted)">
        {SITE.description}
      </p>

      <PostList posts={latest} caption="Latest notes" />

      {
        pinned.length > 0 && (
          <div style="margin-top:16px">
            <PostList posts={pinned} caption="Pinned" />
          </div>
        )
      }

      {hasNone && <p style="font-size:12px">No published notes yet.</p>}
    </Window>
  </div>
</Base>

<style is:global>
  @media (min-width: 641px) {
    .desktop .desktop-icons {
      position: absolute;
      left: 14px;
      top: 14px;
      right: 14px;
    }
  }
</style>
