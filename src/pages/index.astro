---
import Base from "@/layouts/Base.astro";
import Window from "@/components/Window.astro";
import MenuBar from "@/components/MenuBar.astro";
import PostList from "@/components/PostList.astro";
import DesktopIcons from "@/components/DesktopIcons.astro";
import { SITE, HOME_LATEST_COUNT, HOME_PINNED_COUNT } from "@/site.config";
import { getLatest, getPinned } from "@/lib/posts";

const latest = await getLatest(HOME_LATEST_COUNT);
const pinned = await getPinned(HOME_PINNED_COUNT);
const hasNone = latest.length === 0;
---

<Base title={SITE.title} description={SITE.description}>
  <div class="desktop">
    <DesktopIcons />

    <Window
      title="Latest Notes — My Notebook"
      icon="/icons/latest.svg"
      winId="latest"
      floating={true}
      closeAction="hide"
      style="left:24px; top:128px; width:min(780px,94vw);"
    >
      <MenuBar slot="menubar" variant="explorer" />

      <p style="margin:0 0 10px; font-size:12px; color:var(--face-text-muted)">
        {SITE.description}
      </p>

      <PostList posts={latest} caption="Latest notes" />

      {
        pinned.length > 0 && (
          <div style="margin-top:16px">
            <PostList posts={pinned} caption="Pinned" />
          </div>
        )
      }

      {hasNone && <p style="font-size:12px">No published notes yet.</p>}
    </Window>

    <Window
      title="C:\WINDOWS\system32\cmd.exe"
      icon="/icons/cmd.svg"
      winId="terminal"
      floating={true}
      closeAction="hide"
      class="term-window"
      style="left:min(420px,40vw); top:188px; width:min(560px,92vw); display:none;"
    >
      <div class="term" data-terminal>
        <div class="term__out" data-term-out role="log" aria-live="polite" aria-label="Terminal output"></div>
        <label class="term__line">
          <span class="term__prompt">C:\Users\luca&gt;</span>
          <input
            class="term__in"
            data-term-in
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            aria-label="Terminal command input"
          />
        </label>
      </div>
    </Window>
  </div>
</Base>

<script>
  import "@/scripts/terminal.ts";
</script>

<style is:global>
  @media (min-width: 641px) {
    .desktop .desktop-icons {
      position: absolute;
      left: 14px;
      top: 14px;
      right: 14px;
    }
  }
</style>
