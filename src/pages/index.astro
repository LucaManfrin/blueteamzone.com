
---
import Base from "../layouts/Base.astro";
import { SITE } from "../site.config";
---

<Base title={SITE.title} description={SITE.description}>
  <section class="hero">
    <div class="terminal-label">
      <span class="prompt">$</span> welcome
    </div>

    <h1>Blue Team Zone</h1>

    <p class="subtitle">
      Cybersecurity Research & Technical Write-ups
    </p>

    <p class="description">
      A personal cybersecurity notebook focused on
      Incident Response, Digital Forensics, Threat Hunting,
      Detection Engineering, and practical security research.
    </p>

    <div class="hero-actions">
      <a href="/posts/" class="button primary">
        Explore Posts →
      </a>

      <a href="/whoami/" class="button secondary">
        Whoami
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    max-width: 850px;
    min-height: 65vh;
    margin: 0 auto;
    padding: 5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .terminal-label {
    font-family: var(--font-mono);
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .prompt {
    color: var(--color-accent);
    font-weight: 700;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    margin-bottom: 1rem;
  }

  .subtitle {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .description {
    max-width: 650px;
    color: var(--color-text);
    line-height: 1.8;
    margin: 1rem 0 2rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .button:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .primary {
  background: var(--color-accent);
  color: var(--color-on-accent);
  }

  .secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 55vh;
      padding: 3rem 0;
    }
  }
</style>
