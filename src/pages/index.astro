---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import { SITE, HOME_LATEST_COUNT, HOME_PINNED_COUNT } from "@/site.config";
import { getLatest, getPinned } from "@/lib/posts";

const latest = await getLatest(HOME_LATEST_COUNT);
const pinned = await getPinned(HOME_PINNED_COUNT);
---

<Base title={SITE.title} description={SITE.description}>
  <section class="hero window">
    <div class="window__titlebar">
      <span class="dot dot--r"></span>
      <span class="dot dot--y"></span>
      <span class="dot dot--g"></span>
      <span class="title">~/welcome.txt</span>
    </div>
    <div class="window__body">
      <h1>{SITE.title}<span class="blink" aria-hidden="true">_</span></h1>
      <p class="hero__lead">{SITE.description}</p>
    </div>
  </section>

  {
    pinned.length > 0 && (
      <>
        <h2 class="section-label">📌 Pinned</h2>
        <div class="grid">
          {pinned.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </>
    )
  }

  <h2 class="section-label">› Latest notes</h2>
  {
    latest.length > 0 ? (
      <div class="grid">
        {latest.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="page-subtitle">
        No published notes yet. Add a Markdown file under <code>src/content/posts/</code>.
      </p>
    )
  }
</Base>
