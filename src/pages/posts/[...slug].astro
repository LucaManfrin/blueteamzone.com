---
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import Window from "@/components/Window.astro";
import MenuBar from "@/components/MenuBar.astro";
import PostList from "@/components/PostList.astro";
import {
  getListablePosts,
  getRelated,
  readingMinutes,
  postPath,
} from "@/lib/posts";
import { RELATED_COUNT, SITE, categorySlug, categoryBySlug } from "@/site.config";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getListablePosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
};

const { post } = Astro.props as {
  post: Awaited<ReturnType<typeof getListablePosts>>[number];
};
const { Content, headings } = await post.render();

const data = post.data;
const slug = categorySlug(data.category);
const catName = categoryBySlug(slug)?.name ?? data.category;
const minutes = readingMinutes(post);
const related = await getRelated(post, RELATED_COUNT);
const author = data.author ?? SITE.defaultAuthor;
const canonicalPath = postPath(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fileName = (post.slug.split("/").pop() ?? "note").replace(/-/g, "_") + ".txt";
const dateLabel = data.date.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<Base
  title={data.title}
  description={data.description}
  image={data.coverImage ?? SITE.defaultOgImage}
  type="article"
  article={{
    publishedTime: data.date.toISOString(),
    author,
    section: catName,
    tags: data.tags,
  }}
>
  <div class="page-shell">
    <Window
      class="page-window notepad"
      title={`${fileName} — Notepad`}
      icon="/icons/notepad.svg"
      winId="notepad"
      closeAction="back"
    >
      <MenuBar slot="menubar" variant="notepad" />

      <div class="doc" id="article-top">
        <article>
          <div class="article-head">
            <h1>{data.title}</h1>
            <p class="article-meta">
              <a class="cat" href={`/category/${slug}`}>{catName}</a>
              <span>{dateLabel}</span>
              {data.readingTime && <span>{minutes} min read</span>}
              {data.pinned && <span class="pin-flag">pinned</span>}
              <span>by {author}</span>
            </p>
          </div>

          {data.coverImage && (
            <img
              src={data.coverImage}
              alt={`Cover image for ${data.title}`}
              style="width:100%;margin:0 0 16px"
              loading="eager"
              decoding="async"
            />
          )}

          {toc.length >= 3 && (
            <nav class="callout" aria-label="Table of contents" style="margin-bottom:18px">
              <span class="callout__icon" style="background:#6b6f73">≡</span>
              <div>
                <strong>Contents</strong>
                <ol style="margin:6px 0 0;padding-left:18px">
                  {toc.map((h) => (
                    <li style={h.depth === 3 ? "margin-left:14px" : ""}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          )}

          <div class="prose">
            <Content />
          </div>

          {data.tags.length > 0 && (
            <ul class="tags">
              {data.tags.map((t) => (
                <li class="tag">#{t}</li>
              ))}
            </ul>
          )}

          <p class="article-meta" style="margin-top:22px;border-bottom:0;border-top:1px solid var(--sh-1);padding-top:10px">
            <a href={canonicalPath} rel="bookmark">permalink</a>
            <a href="/find">find more notes…</a>
          </p>

          {related.length > 0 && (
            <div style="margin-top:8px">
              <PostList posts={related} caption="Related notes" />
            </div>
          )}
        </article>
      </div>
    </Window>
  </div>
</Base>
