
---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllPosts } from "../../lib/posts";
import { CATEGORIES, POSTS_PER_PAGE } from "../../site.config";

const allPosts = await getAllPosts();

const totalPages = Math.ceil(
  allPosts.length / POSTS_PER_PAGE
);

const posts = allPosts.slice(0, POSTS_PER_PAGE);

const categoryOrder = [
  "Active-Directory",
  "Linux",
  "macOS",
  "Threat-Hunting",
  "Tools",
  "Windows",
];

const orderedCategories = categoryOrder
  .map((slug) => CATEGORIES.find((cat) => cat.slug === slug))
  .filter((cat): cat is (typeof CATEGORIES)[number] => Boolean(cat));

---

<Base
  title="Posts | Blue Team Zone"
  description="Cybersecurity articles, research and technical write-ups."
>
  <div class="page-intro">
    <h1>Posts</h1>
    <p>
      Explore cybersecurity write-ups, research,
      investigations and practical guides.
    </p>
  </div>

  <section class="categories-section">
    <h2>Browse by Category</h2>

    <nav class="categories" aria-label="Post categories">
      <a href="/posts/" class="category active">
        All Posts
      </a>

      {orderedCategories.map((cat) => (
        <a
          href={`/category/${cat.slug}/`}
          class="category"
        >
          {cat.label}
        </a>
      ))}
    </nav>
  </section>

  <section class="posts-section">
    <h2>Latest Posts</h2>

    <div class="posts-grid">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          slug={post.id}
          category={post.data.category}
          tags={post.data.tags}
          pinned={post.data.pinned}
        />
      ))}
    </div>

    {totalPages > 1 && (
      <nav
        class="pagination"
        aria-label="Posts pagination"
      >
        <a href="/posts/2/">
          Next Page →
        </a>
      </nav>
    )}
  </section>
</Base>

<style>
  .page-intro {
    padding: 2rem 0;
    margin-bottom: 1rem;
  }

  .page-intro h1 {
    margin-bottom: 0.75rem;
  }

  .page-intro p {
    color: var(--color-text);
    max-width: 700px;
  }

  .categories-section {
    margin-bottom: 3rem;
  }

  .categories-section h2,
  .posts-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .category {
    display: inline-block;
    padding: 0.6rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-text);
    font-size: 0.9rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .category:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }

   .category.active {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 600;
  }

  .posts-grid {
  display: grid;
  grid-template-columns: repeat(
    auto-fill,
    minmax(300px, 1fr)
  );
  gap: 1rem;
  margin-bottom: 2rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }

  .pagination a {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .page-intro {
      padding: 1rem 0;
    }
  }
</style>
