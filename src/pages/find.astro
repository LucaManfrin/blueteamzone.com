---
import Base from "@/layouts/Base.astro";
import Window from "@/components/Window.astro";
import MenuBar from "@/components/MenuBar.astro";
import DesktopIcons from "@/components/DesktopIcons.astro";
---

<Base
  title="Find: Notes"
  description="Search all published notes on this site."
  noindex={true}
>
  <div class="desktop">
    <DesktopIcons />

    <Window
      title="Find: Notes"
      icon="/icons/find.svg"
      winId="find"
      floating={true}
      closeAction="back"
      style="left:24px; top:128px; width:min(620px,94vw);"
    >
      <MenuBar slot="menubar" variant="explorer" />

      <form class="find" role="search" autocomplete="off">
        <div class="find__row">
          <label for="find-input">Named:</label>
          <input
            id="find-input"
            class="field"
            type="search"
            name="q"
            placeholder="type a word, tag or phrase…"
            aria-label="Search notes"
            aria-controls="find-results"
            autofocus
          />
          <button class="btn" type="submit">Find Now</button>
        </div>
        <p style="margin:0;font-size:11px;color:var(--face-text-muted)">
          Searches titles, descriptions, tags and body text of all published
          notes. Tip: press <kbd>/</kbd> anywhere to jump here.
        </p>
      </form>

      <div
        id="find-results"
        class="filelist"
        style="margin-top:12px"
        role="region"
        aria-live="polite"
        aria-label="Search results"
      >
        <div class="search-empty">Start typing to search…</div>
      </div>
    </Window>
  </div>
</Base>

<style is:global>
  @media (min-width: 641px) {
    .desktop .desktop-icons {
      position: absolute;
      left: 14px;
      top: 14px;
      right: 14px;
    }
  }
</style>

<script>
  import "@/scripts/find.ts";
</script>
