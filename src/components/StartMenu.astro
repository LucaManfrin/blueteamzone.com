---
import { SOCIAL, CATEGORIES } from "@/site.config";

const social = [
  { href: SOCIAL.github, label: "GitHub", icon: "/icons/social-github.svg" },
  { href: SOCIAL.linkedin, label: "LinkedIn", icon: "/icons/social-linkedin.svg" },
  { href: SOCIAL.credly, label: "Credly", icon: "/icons/social-credly.svg" },
].filter((s) => s.href && s.href.trim() !== "");
---

<div id="start-menu" class="start-menu" role="menu" aria-label="Start menu">
  <div class="start-menu__top" aria-hidden="true"></div>
  <div class="start-menu__list">
    {
      CATEGORIES.map((c) => (
        <a href={`/category/${c.slug}`} role="menuitem">
          <img src={`/icons/cat-${c.slug}.svg`} alt="" />
          {c.name}
        </a>
      ))
    }

    <div class="start-menu__sep" role="separator"></div>

    <a href="/find" role="menuitem">
      <img src="/icons/find.svg" alt="" />Find Notes
    </a>
    <a href="/rss.xml" role="menuitem">
      <img src="/icons/social-rss.svg" alt="" />RSS Feed
    </a>
    {
      social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer me" role="menuitem">
          <img src={s.icon} alt="" />
          {s.label}
        </a>
      ))
    }

    <div class="start-menu__sep" role="separator"></div>

    <button type="button" data-act="theme" role="menuitem">
      <span class="sm-icon" aria-hidden="true">◐</span> Night Mode
    </button>
    <a href="/find" role="menuitem" class="start-menu__about">
      <img src="/icons/help.svg" alt="" />About / Search
    </a>
  </div>
</div>
