---
import { CATEGORIES } from "@/site.config";
// Fixed display order: Profile, Find Notes, then categories, then RSS.
const cats = CATEGORIES; // windows, active-directory, linux, macos, threat-hunting, tools
---

<div class="desktop-icons" role="list" aria-label="Desktop shortcuts">
  <a class="dicon" href="/" role="listitem" data-open="latest" data-dblnav>
    <img src="/images/og-default.png" alt="" width="40" height="40" style="object-fit:cover;border-radius:4px" />
    <span>Profile</span>
  </a>

  <a class="dicon" href="/find" role="listitem" data-dblnav>
    <img src="/icons/find.svg" alt="" width="40" height="40" />
    <span>Find Notes</span>
  </a>

  {
    cats.map((c) => (
      <a class="dicon" href={`/category/${c.slug}`} role="listitem" data-dblnav>
        <img src={`/icons/cat-${c.slug}.svg`} alt="" width="40" height="40" />
        <span>{c.name}</span>
      </a>
    ))
  }

  <a class="dicon" href="/rss.xml" role="listitem" data-dblnav>
    <img src="/icons/Generic_Feed-icon.svg.png" alt="" width="40" height="40" />
    <span>RSS Feed</span>
  </a>
</div>
