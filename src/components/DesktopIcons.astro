---
import { CATEGORIES } from "@/site.config";
// Fixed order: Profile, Find Notes, then categories, then cmd + RSS.
const cats = CATEGORIES;
---

<div class="desktop-icons" role="list" aria-label="Desktop shortcuts">
  <a class="dicon" href="/" role="listitem" data-open="latest" data-dblnav>
    <img src="/images/website-logo.png" alt="" width="40" height="40" style="object-fit:cover;border-radius:4px" />
    <span>Profile</span>
  </a>

  <a class="dicon" href="/find" role="listitem" data-dblnav>
    <img src="/icons/find.svg" alt="" width="40" height="40" />
    <span>Find Notes</span>
  </a>

  {
    cats.map((c) => (
      <a class="dicon" href={`/category/${c.slug}`} role="listitem" data-dblnav>
        <img src={`/icons/category-${c.slug}.svg`} alt="" width="40" height="40" />
        <span>{c.name}</span>
      </a>
    ))
  }

  <a class="dicon" href="/" role="listitem" data-open="terminal" data-dblnav>
    <img src="/icons/cmd.svg" alt="" width="40" height="40" />
    <span>cmd.exe</span>
  </a>

  <a class="dicon" href="/rss.xml" role="listitem" data-dblnav>
    <img src="/icons/rss-icon.png" alt="" width="40" height="40" />
    <span>RSS Feed</span>
  </a>
</div>
