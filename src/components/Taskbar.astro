---
import { SOCIAL } from "@/site.config";

const social = [
  { href: SOCIAL.github, label: "GitHub", emoji: "🤖" },
  { href: SOCIAL.linkedin, label: "LinkedIn", emoji: "💼" },
  { href: SOCIAL.credly, label: "Credly", emoji: "🏅" },
].filter((s) => s.href && s.href.trim() !== "");
---

<nav class="taskbar" aria-label="Taskbar">
  <button
    id="start-button"
    class="start-btn"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="start-menu"
  >
    <img src="/images/logo.png" alt="" width="20" height="20" />
    start
  </button>

  <span class="task-divider" aria-hidden="true"></span>

  <div id="task-windows" class="task-windows" role="group" aria-label="Open windows"></div>

  <div class="tray" role="group" aria-label="System tray">
    <button
      id="mute-toggle"
      type="button"
      aria-pressed="true"
      title="Sound: off (click to enable UI sounds)"
      aria-label="Toggle interface sounds"
    >
      <span aria-hidden="true" data-on="🔊" data-off="🔈">🔈</span>
    </button>
    <button
      id="theme-toggle"
      type="button"
      data-act="theme"
      aria-pressed="false"
      title="Toggle night mode"
      aria-label="Toggle night mode"
    >
      <span aria-hidden="true">◐</span>
    </button>
    {
      social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer me" title={s.label} aria-label={s.label}>
          <span class="tray-emoji" aria-hidden="true">{s.emoji}</span>
        </a>
      ))
    }
    <a href="/rss.xml" title="RSS feed" aria-label="RSS feed">
      <img src="/icons/rss-icon.png" alt="" width="18" height="18" />
    </a>
    <time id="clock" class="clock" aria-live="off">--:--</time>
  </div>
</nav>
