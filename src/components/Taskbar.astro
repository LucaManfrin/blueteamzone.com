---
import { SOCIAL } from "@/site.config";

const social = [
  { key: "github", href: SOCIAL.github, label: "GitHub", glyph: "GH" },
  { key: "linkedin", href: SOCIAL.linkedin, label: "LinkedIn", glyph: "in" },
  { key: "credly", href: SOCIAL.credly, label: "Credly", glyph: "Cr" },
].filter((s) => s.href && s.href.trim() !== "");
---

<nav class="taskbar" aria-label="Taskbar">
  <button
    id="start-button"
    class="start-btn"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="start-menu"
  >
    <img src="/icons/start-flag.svg" alt="" width="18" height="18" />
    start
  </button>

  <span class="task-divider" aria-hidden="true"></span>

  <div
    id="task-windows"
    class="task-windows"
    role="group"
    aria-label="Open windows"
  >
  </div>

  <div class="tray" role="group" aria-label="System tray">
    <button
      id="mute-toggle"
      type="button"
      aria-pressed="true"
      title="Sound: off (click to enable UI sounds)"
      aria-label="Toggle interface sounds"
    >
      <span aria-hidden="true" data-on="🔊" data-off="🔈">🔈</span>
    </button>
    <button
      id="theme-toggle"
      type="button"
      aria-pressed="false"
      title="Toggle night mode"
      aria-label="Toggle night mode"
    >
      <span aria-hidden="true">◐</span>
    </button>
    {
      social.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer me"
          title={s.label}
          aria-label={s.label}
        >
          <span aria-hidden="true" style="font-size:10px;font-weight:700">
            {s.glyph}
          </span>
        </a>
      ))
    }
    <a href="/rss.xml" title="RSS feed" aria-label="RSS feed">
      <span aria-hidden="true" style="font-size:11px">≈</span>
    </a>
    <time id="clock" class="clock" aria-live="off">--:--</time>
  </div>
</nav>
