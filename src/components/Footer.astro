---
import { SITE, SOCIAL } from "@/site.config";
const year = new Date().getFullYear();

// Only expose link types explicitly allowed by the spec. No email/phone/etc.
const links = [
  {
    key: "github",
    href: SOCIAL.github,
    label: "GitHub",
    icon: "M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z",
  },
  {
    key: "linkedin",
    href: SOCIAL.linkedin,
    label: "LinkedIn",
    icon: "M20.45 20.45h-3.56v-5.57c0-1.33 0-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.74v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.76V1.74C24 .78 23.2 0 22.22 0Z",
  },
  {
    key: "credly",
    href: SOCIAL.credly,
    label: "Credly",
    icon: "M12 2 3 6v6c0 5 3.8 8.6 9 10 5.2-1.4 9-5 9-10V6l-9-4Zm0 5.2a3.3 3.3 0 1 1 0 6.6 3.3 3.3 0 0 1 0-6.6Zm0 8.1c1.5 0 3 .6 3.9 1.6a6.4 6.4 0 0 1-7.8 0c.9-1 2.4-1.6 3.9-1.6Z",
  },
].filter((l) => l.href && l.href.trim() !== "");
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p style="margin:0">
      © {year} {SITE.authorName}. Built static &amp; hardened. No trackers, no
      ads.
    </p>
    <nav class="social" aria-label="Social links">
      {
        links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={l.label}
            title={l.label}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={l.icon} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
</footer>
