---
import { SITE } from "@/site.config";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  /** Set true to keep a page out of search engines (e.g. archived). */
  noindex?: boolean;
  /** Article-specific structured data. */
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  type = "website",
  noindex = false,
  article,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(
  /([^/])$/,
  "$1"
);
const ogImage = new URL(image, SITE.url).href;
const fullTitle =
  title === SITE.title ? title : `${title} · ${SITE.title}`;

const schema =
  type === "article" && article
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: ogImage,
        datePublished: article.publishedTime,
        dateModified: article.modifiedTime ?? article.publishedTime,
        author: {
          "@type": "Person",
          name: article.author ?? SITE.defaultAuthor,
        },
        publisher: {
          "@type": "Organization",
          name: SITE.title,
        },
        articleSection: article.section,
        keywords: article.tags?.join(", "),
        mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        description: SITE.description,
        url: SITE.url,
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content="Astro" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Anti-FOUC theme bootstrap (external, same-origin -> strict CSP) -->
<script is:inline src="/theme-init.js"></script>

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.png" />
<meta name="theme-color" content="#15161c" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={SITE.lang} />
{
  type === "article" && article && (
    <>
      {article.publishedTime && (
        <meta
          property="article:published_time"
          content={article.publishedTime}
        />
      )}
      {article.section && (
        <meta property="article:section" content={article.section} />
      )}
      {article.tags?.map((t) => (
        <meta property="article:tag" content={t} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href="/rss.xml"
/>

<!-- Structured data -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>
