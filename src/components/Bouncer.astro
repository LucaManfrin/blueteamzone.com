---
// Subtle, always-on bouncing logo (the "DVD corner" easter egg).
// Sits behind content, very low opacity, ignores pointer + reduced-motion.
---

<div id="dvd-bouncer" aria-hidden="true">
  <svg viewBox="0 0 120 64" xmlns="http://www.w3.org/2000/svg">
    <rect
      x="2"
      y="2"
      width="116"
      height="60"
      rx="6"
      fill="none"
      data-tint
      stroke="#f2a65a"
      stroke-width="3"></rect>
    <text
      x="60"
      y="40"
      text-anchor="middle"
      font-family="monospace"
      font-size="22"
      font-weight="700"
      data-fill
      fill="#f2a65a">&gt;_sec</text>
  </svg>
</div>

<script>
  import "@/scripts/bouncer.ts";
</script>
